{
  // Cloudflare Workers static-assets deploy. Workers Builds runs `npx wrangler deploy`.
  // If your Worker in the Cloudflare dashboard has a different name, change "name" to match it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2k-power-play",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
