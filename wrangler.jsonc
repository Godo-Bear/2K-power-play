{
  // Cloudflare Workers config. Workers Builds runs `npx wrangler deploy`.
  // If your Worker in the Cloudflare dashboard has a different name, change "name" to match it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2k-power-play",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // The game itself: static files
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* goes to the Worker code (accounts and online rooms) instead of the static files
    "run_worker_first": ["/api/*"]
  },
  // Durable Objects (all work on the free plan):
  //  - Room: one per online room code
  //  - User: one per account (password hash and sign-in sessions)
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "USERS", "class_name": "User" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["User"] }
  ]
}
